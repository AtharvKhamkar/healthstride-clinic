# HealthStride Admin Portal Environment Configuration
# Copy this file to .env.development or .env.production and fill in the values

# ===========================================
# API Configuration
# ===========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_GUEST_API_KEY=
NEXT_PUBLIC_X_API_KEY=
NEXT_PUBLIC_X_API_SECRET_KEY=

# ===========================================
# Timeouts (in milliseconds)
# ===========================================
NEXT_PUBLIC_CONNECT_TIMEOUT=30000
NEXT_PUBLIC_RECEIVE_TIMEOUT=30000
NEXT_PUBLIC_SEND_TIMEOUT=30000

# ===========================================
# Environment
# ===========================================
# NEXT_PUBLIC_APP_ENV=development  # Optional: 'development' or 'production'
# NODE_ENV=development             # Set automatically by Next.js